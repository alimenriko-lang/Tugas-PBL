PORT=5000
DB_HOST=host dari tidb
DB_PORT=3306
DB_USER=User Tidb
DB_PASSWORD=Password Tidb
DB_NAME=task_manager
JWT_SECRET=yang_rahasia_untuk_jwt

# Frontend Base URL (untuk redirect setelah OAuth)
FRONTEND_URL=https://taskeco.vercel.app

# Google OAuth 2.0 Configuration
# Dapatkan dari Google Cloud Console -> APIs & Services -> Credentials
# Authorized redirect URI: https://taskeco.onrender.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://taskeco.onrender.com/api/auth/google/callback

# GitHub OAuth App Configuration
# Dapatkan dari GitHub Settings -> Developer settings -> OAuth Apps
# Authorization callback URL: https://taskeco.onrender.com/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://taskeco.onrender.com/api/auth/github/callback

# Konfigurasi SMTP Pengiriman Email (Opsional / Produksi)
# Jika dikosongkan, pesan formulir kontak disimpan langsung ke database MySQL
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=emailanda@gmail.com
SMTP_PASS=app_password_anda
# Email admin penerima pesan formulir kontak dari Landing Page
ADMIN_EMAIL=namaemail@email.com

# Google Gemini API Key (untuk AI Chatbot pada Landing Page)
# Dapatkan dari: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
